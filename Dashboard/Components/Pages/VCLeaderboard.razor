@page "/leaderboard/vc/{guild_id}"
@page "/leaderboard/vc/{guild_id}/{page:int}"
@attribute [ExcludeFromInteractiveRouting]
@using Fluxify.Rest
@using Ledger.Services
@using Database
@using Database.Services
@using Microsoft.AspNetCore.Mvc.ModelBinding
@inject GuildDbService guild_db
@inject LeaderboardDbService db
@inject BotRestClient rest
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims

@using Dashboard.Models

<PageTitle>Guild VC Leaderboard</PageTitle>
<h1>VC Leaderboard</h1>

<div class="d-flex justify-content-center gap-2 mt-3">
    <a href="/leaderboard/@guild_id" class="btn btn-primary">Go to chat Leaderboard</a>
</div>

@if (tableUsers.Count == 0)
{
    <p><em>There seems to be no users with experience on this server...</em></p>
}
else
{
    @if (page == 0)
    {
        var user1 = tableUsers.FirstOrDefault(u => u.Position == 1);
        var user2 = tableUsers.FirstOrDefault(u => u.Position == 2);
        var user3 = tableUsers.FirstOrDefault(u => u.Position == 3);

        <div class="d-flex justify-content-center align-items-end gap-3 mb-4" style="min-height: 320px;">
            @if (user2 != null)
            {
                <div class="card podium-card podium-silver text-center" style="width: 220px;">
                    <div class="card-body">
                        <i class="bi bi-award-fill fs-1" style="color: var(--bs-secondary);"></i>
                        <br>
                        @if (user2.AvatarURL != null)
                        {
                            <img class="rounded-circle border border-2 border-secondary mt-1" src="@user2.AvatarURL" width="80" height="80" style="object-fit: cover;" alt="">
                        }
                        <h5 class="mt-2 mb-0">@user2.Name</h5>
                        <div class="text-muted small">Level @user2.CurrentLevel · @user2.Exp XP</div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar" style="width: @user2.BarPercentage%; background: var(--bs-secondary);"></div>
                        </div>
                        <div class="mt-1 fw-bold small" style="color: var(--bs-secondary);">#2</div>
                    </div>
                </div>
            }
            @if (user1 != null)
            {
                <div class="card podium-card podium-gold text-center" style="width: 260px; z-index: 1;">
                    <div class="card-body">
                        <i class="bi bi-trophy-fill fs-1" style="color: var(--bs-warning);"></i>
                        <br>
                        @if (user1.AvatarURL != null)
                        {
                            <img class="rounded-circle border border-3 border-warning mt-1" src="@user1.AvatarURL" width="100" height="100" style="object-fit: cover;" alt="">
                        }
                        <h4 class="mt-2 mb-0">@user1.Name</h4>
                        <div class="text-muted small">Level @user1.CurrentLevel · @user1.Exp XP</div>
                        <div class="progress mt-2" style="height: 8px;">
                            <div class="progress-bar" style="width: @user1.BarPercentage%; background: var(--bs-warning);"></div>
                        </div>
                        <div class="mt-1 fw-bold small" style="color: var(--bs-warning);">#1</div>
                    </div>
                </div>
            }
            @if (user3 != null)
            {
                <div class="card podium-card podium-bronze text-center" style="width: 220px;">
                    <div class="card-body">
                        <i class="bi bi-star-fill fs-1" style="color: var(--bs-danger);"></i>
                        <br>
                        @if (user3.AvatarURL != null)
                        {
                            <img class="rounded-circle border border-2 border-danger mt-1" src="@user3.AvatarURL" width="80" height="80" style="object-fit: cover;" alt="">
                        }
                        <h5 class="mt-2 mb-0">@user3.Name</h5>
                        <div class="text-muted small">Level @user3.CurrentLevel · @user3.Exp XP</div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar" style="width: @user3.BarPercentage%; background: var(--bs-danger);"></div>
                        </div>
                        <div class="mt-1 fw-bold small" style="color: var(--bs-danger);">#3</div>
                    </div>
                </div>
            }
        </div>
    }

    <table class="table w-100 align-middle text-center">
        <thead>
            <tr>
                <td>Position</td>
                <td>Name</td>
                <td>Level</td>
                <td>Exp</td>
                <td></td>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in tableUsers)
            {
                <tr>
                    <td>#@user.Position</td>
                    <td>
                        @if (user.AvatarURL != null)
                        {
                            <img class="rounded-circle me-1" src="@user.AvatarURL" width="24" height="24" style="object-fit: cover;" alt="">
                        }
                        @user.Name
                    </td>
                    <td>@user.CurrentLevel</td>
                    <td>@user.Exp</td>
                    <td class="d-none d-md-table-cell">
                        <div style="width: 10rem; background: var(--bs-body-bg-alt); border-radius: 4px;">
                            <div style="width: @user.BarPercentage%; background: var(--bs-primary); height: 10px; border-radius: 4px;"></div>
                        </div>
                    </td>
                </tr>
                <tr class="d-table-row d-md-none">
                    <td colspan="4" class="pt-2">
                        <div style="width: 100%; background: var(--bs-body-bg-alt); border-radius: 4px;">
                            <div style="width: @user.BarPercentage%; background: var(--bs-primary); height: 10px; border-radius: 4px;"></div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex justify-content-center gap-2 mt-3">
    @if (page > 0)
    {
        <a href="/leaderboard/vc/@guild_id/@(page - 1)" class="btn btn-primary">Previous</a>
    }
    <span class="btn disabled">Page @(page + 1)</span>
    @if (HasNextPage)
    {
        <a href="/leaderboard/vc/@guild_id/@(page + 1)" class="btn btn-primary">Next</a>
    }
</div>

@code {
    private List<User> tableUsers = new();
    [Parameter] public string? guild_id { get; set; }
    [Parameter] public int page { get; set; } = 0;

    private const int PageSize = 50;
    private bool HasNextPage = false;
    protected override async Task OnInitializedAsync()
    {

        var db_users = await db.GetGuildVCLeaderboard(Convert.ToInt64(guild_id), page, PageSize, PageSize + 1) ?? new();
        HasNextPage = db_users.Count > PageSize;
        db_users = db_users.Take(PageSize).ToList();
        var actual_users = new List<User>();
        var idx = (page * PageSize) + 1;
        var guild = await guild_db.GetOrCreateGuildAsync(long.Parse(guild_id!));
        var guildSettings = await db.GetOrCreateSettingsAsync(guild);
        foreach (var user in db_users)
        {
            var fluxerUser = await rest.Users[user.User.UserId].GetAsync();
            if (fluxerUser is not null)
            {
                var level = guildSettings.GetLevel(user.Exp);
                var bar_percentage = (float)(user.Exp - guildSettings.GetTotalXpForLevel(level)) / (float)(user.Exp + guildSettings.GetTotalXpForLevel(level + 1) - guildSettings.GetTotalXpForLevel(level));
                var url = $"https://fluxerusercontent.com/avatars/{user.User.UserId}/{fluxerUser.Avatar}.webp" ?? null;

                actual_users.Add(
                    new User
                    {
                        Name = fluxerUser.Username,
                        Exp = user.Exp,
                        CurrentLevel = level,
                        BarPercentage = (int)(bar_percentage * 100),
                        Position = idx,
                        AvatarURL = url
                    }
                );

            }
            idx += 1;
        }
        tableUsers = actual_users;

    }

    private class User
    {
        public string Name { get; set; }
        public int Exp { get; set; }
        public int CurrentLevel { get; set; }
        public int BarPercentage { get; set; }
        public int Position { get; set; }
        public string? AvatarURL { get; set; }
    }
}
